{
  "name": "claude-tracker",
  "version": "0.1.0",
  "description": "Track Claude Code evolution with semantic symbol naming",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc",
    "dev": "tsc --watch",
    "test": "node --test",
    "lint": "eslint src",
    "annotate": "node dist/cli/annotate.js",
    "rename": "node dist/cli/rename.js",
    "stats": "node dist/cli/stats.js",
    "fingerprint": "node dist/cli/fingerprint.js"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@babel/generator": "^7.24.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
